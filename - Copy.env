# ===== AI providers (upar wala pehle try hoga, limit aaye to agla) =====
PROVIDER_ORDER=gemini,groq,openrouter,mistral

# Gemini (nayi key daalo, purani delete kar do)
GEMINI_API_KEY==
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview

# Groq (console.groq.com -> API Keys; Models page se vision model ka naam copy karo)
GROQ_API_KEY==
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter (optional, khaali chhod do to skip hoga)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Mistral (optional, khaali chhod do to skip hoga)
MISTRAL_API_KEY=
MISTRAL_MODEL=

# ===== Telegram alerts (optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=998394672

# ===== Phone =====
# USB se jodoge to `adb devices` ka serial yahan daalo (jaise R58M12345AB), wo kabhi change nahi hota
ANDROID_SERIAL=192.168.18.8:39311
APPIUM_URL=http://127.0.0.1:4723

# Prompt added to every YouTube AI Short request
SHORT_PROMPT_STYLE=Create a 20 second vertical product showcase short with a natural voiceover in Hindi-English, highlight features, no price claims.
