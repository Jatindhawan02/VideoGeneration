# Optional image-generation model. Must be an image-output-capable Gemini model enabled for your key.
# If unset or unavailable, the cover uses a Pillow-generated pastel gradient instead.
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_PROVIDER_ORDER=gemini

# Reel-only mode: path is set by the control server when an optional cover image is uploaded.
# Do not manually set this permanently unless you want the same cover reused each run.
REEL_COVER_UPLOAD_PATH=
